{
	"schemaVersion": 1,
	"id": "filled-hitbox",
	"version": "${version}",
	"name": "Filled Hitbox",
	"description": "Shows a colour-filled hitbox when the player glides with an elytra.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/filled-hitbox/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.filledhitbox.FilledHitbox"
		],
		"client": [
			"com.example.filledhitbox.client.FilledHitboxClient"
		]
	},
	"mixins": [
		"filled-hitbox.mixins.json",
		{
			"config": "filled-hitbox.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
